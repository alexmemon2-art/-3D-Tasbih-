<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_emerald"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_small_open_app"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_small_dhikr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="سُبْحَانَ اللَّهِ"
            android:textColor="#F4D03F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_small_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 33"
            android:textColor="#FFF5F0E1"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_small_plus_btn"
        android:layout_width="52dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_btn_gold"
        android:gravity="center"
        android:text="+1"
        android:textColor="#09291A"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
